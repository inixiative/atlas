#!/usr/bin/env sh
# Example local hook — copy to .husky/pre-commit (or .git/hooks/pre-commit; chmod +x).
# Checks the files you're about to commit (presence + vocab), in one atlas run; a staged file
# atlas doesn't consider is ignored. Scoped runs skip the registry-wide reference check.
# NUL-separated and unquoted (core.quotePath=false) so spaces and non-ASCII names survive.

git -c core.quotePath=false diff --cached --name-only -z --diff-filter=ACMR \
  | xargs -0 -r bunx @inixiative/atlas check
status=$?

if [ "$status" -ne 0 ]; then
  echo "atlas: fix the annotations above, or run 'bunx @inixiative/atlas stamp <file> --write' to fill them."
fi
exit "$status"
